# Netlify response headers.
#
# Server-level noindex for every private application surface. This is the
# production replacement for the X-Robots-Tag that functions/_middleware.ts sets:
# that file is a Cloudflare Pages Function and does not execute on Netlify, so
# until now the only protection on these routes was client-side useEffect
# metadata — which a crawler that does not run JavaScript never sees.
#
# Exact prefix roots are listed alongside their splats because Netlify's "/app/*"
# does not match "/app" itself, and the portal roots are the most linkable URLs
# of the set.
#
# Route families verified against src/App.tsx and src/lib/routing/indexability.ts:
#   /app     customer portal (+ /app/login, /app/signup, /app/reset-password, ...)
#   /admin   unified internal workspace (admin + owner finance)
#   /owner   legacy owner redirects
#   /auth    Supabase confirmation / post-login role resolution
#   /d       tokenized customer document portal
#
# noarchive is included so no cached copy of an authenticated shell can be served
# from a search engine's cache.
#
# ---------------------------------------------------------------------------
# Cache-Control on the HTML, and ONLY on the HTML.
#
# Every one of these routes is served an SPA shell document whose <script> tags
# name content-hashed chunks. A deploy renames every chunk. If a browser or edge
# still holds the previous HTML it will ask for a filename that no longer exists,
# the dynamic import fails, and the customer gets a broken page — which is exactly
# how a freshly emailed /d/<token> offer link opened to a blank screen.
#
# `no-cache` does not mean "do not store": it means "revalidate before reuse", so
# the shell is cheap to serve and can never be stale after a deploy. Vite
# recommends precisely this for the HTML entry.
#
# Cloudflare matches these rules against the REQUEST path, not against the file
# that ends up being served — which is why /d/* is the correct target even though
# the body comes from app-shell.html (or index.html via SPA fallback). The
# X-Robots-Tag rules below have always depended on that same behaviour.
#
# Deliberately NOT here: /assets/*. Those filenames are content-hashed, so they
# are immutable by construction and must keep their long-lived caching. Adding
# no-cache there would re-download the whole bundle on every navigation and fix
# nothing.
#
# functions/_middleware.ts already sets the same header on HTML it returns. These
# rules are not redundant. Cloudflare Pages evaluates _redirects BEFORE Pages
# Functions, so a private deep link is answered by the /app-shell rewrite and
# the middleware never runs for it — _headers is what carries the policy there.
# ---------------------------------------------------------------------------

/app
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/app/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/owner
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/owner/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/auth
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/auth/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/d
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate
/d/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate

# The 404 document is served for every unknown public URL. It must never be
# indexed under any of those URLs.
/404.html
  X-Robots-Tag: noindex, nofollow

# The private SPA fallback document (see public/_redirects). Reachable directly
# as a static file, so it carries the same protection as the routes it serves.
/app-shell.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache, must-revalidate

# The prerendered homepage. It is NOT a fallback for anything: private routes are
# rewritten to /app-shell and unknown URLs are served /404 by
# functions/_middleware.ts. It is still an HTML pointer to hashed chunks and must
# revalidate like any other document.
/index.html
  Cache-Control: no-cache, must-revalidate
